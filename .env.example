# football-data.org API key (free at https://www.football-data.org/client/register)
# Must match Worker env FDORG_TOKEN
FDO_API_KEY=your_fdo_api_key_here

# Supabase (optional — upsert script)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloudflare R2 (optional — enable R2 in dashboard first)
CF_ACCOUNT_ID=6f9202ab64a3eb5dbe3a69df19dd462a
CF_R2_BUCKET=kouvadeiros-scores
CF_R2_ACCESS_KEY_ID=your_r2_access_key
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_key

# Workers KV fallback (existing kouvadeiros namespace)
CF_KV_NAMESPACE_ID=5988821db92146b08969e4b27ec8854e

# Optional direct CDN URLs (if not using Worker /live-scores)
LIVE_SCORES_JSON_URL=
TODAY_SCORES_JSON_URL=
